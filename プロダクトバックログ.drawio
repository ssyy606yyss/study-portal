e=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1180" y="1474" width="55" height="56" as="geometry"/></mxCell><mxCell id="202" value="未定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1235" y="1474" width="60" height="56" as="geometry"/></mxCell><mxCell id="203" value="実装済" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1295" y="1474" width="80" height="56" as="geometry"/></mxCell><mxCell id="204" value="B25" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="60" height="56" as="geometry"/></mxCell><mxCell id="205" value="E6 共通・仕上げ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="100" y="1530" width="120" height="56" as="geometry"/></mxCell><mxCell id="206" value="自分として、どこからでも見たいので、GitHub Pages等で公開したい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="220" y="1530" width="470" height="56" as="geometry"/></mxCell><mxCell id="207" value="URLで開ける(公開範囲は別途検討)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="690" y="1530" width="420" height="56" as="geometry"/></mxCell><mxCell id="208" value="Could" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1530" width="70" height="56" as="geometry"/></mxCell><mxCell id="209" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1180" y="1530" width="55" height="56" as="geometry"/></mxCell><mxCell id="210" value="未定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1235" y="1530" width="60" height="56" as="geometry"/></mxCell><mxCell id="211" value="未着手" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1295" y="1530" width="80" height="56" as="geometry"/></mxCell><mxCell id="212" value="B26" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1586" width="60" height="56" as="geometry"/></mxCell><mxCell id="213" value="E6 共通・仕上げ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="100" y="1586" width="120" height="56" as="geometry"/></mxCell><mxCell id="214" value="自分として、品質を保ちたいので、全ページをW3C HTMLチェッカー/CSSバリデータで検証し、実機ブラウザでも動作確認したい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="220" y="1586" width="470" height="56" as="geometry"/></mxCell><mxCell id="215" value="全ページでエラー0 / 主要ブラウザ・スマホ幅で操作できる" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="690" y="1586" width="420" height="56" as="geometry"/></mxCell><mxCell id="216" value="Must" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1586" width="70" height="56" as="geometry"/></mxCell><mxCell id="217" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1180" y="1586" width="55" height="56" as="geometry"/></mxCell><mxCell id="218" value="#6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1235" y="1586" width="60" height="56" as="geometry"/></mxCell><mxCell id="219" value="未着手" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1295" y="1586" width="80" height="56" as="geometry"/></mxCell><mxCell id="220" value="&lt;b&gt;合計 26件 / 83ポイント&lt;/b&gt;　実装済 24件 / 78ポイント、残り 2件(B25 公開、B26 品質チェック)&lt;br&gt;&lt;b&gt;「実装済」の意味:&lt;/b&gt;機能を作り、ヘッドレスChromeでの動作確認(入力チェック・保存・編集・削除・絞り込み・グラフ表示など)まで済んだ状態。&lt;b&gt;W3Cチェッカーでの検証と実機ブラウザでの確認は B26 で行う&lt;/b&gt;(完成の定義はそれまで未達)。&lt;br&gt;※見積りは仮置き。やってみて実際にかかった感覚で見直す" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="1662" width="1620" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2.イテレーション計画"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="🏁 イテレーション計画(ざっくり)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;#1 骨組み+勉強記録 ✅実装済&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="4" value="ゴール:勉強記録を毎日つけられる状態にする(MVP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;verticalAlign=top;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="260" height="70" as="geometry"/></mxCell><mxCell id="5" value="✅ &lt;b&gt;B01&lt;/b&gt; (3pt)&lt;br&gt;どのページからも5つの入口へ移動したいので、共通メニュー付きのトップページが欲しい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="260" height="80" as="geometry"/></mxCell><mxCell id="6" value="✅ &lt;b&gt;B02&lt;/b&gt; (2pt)&lt;br&gt;ファイルを探しやすいよう、html/ のフォルダ構成とCSSを共通化したい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="260" height="80" as="geometry"/></mxCell><mxCell id="7" value="✅ &lt;b&gt;B03&lt;/b&gt; (5pt)&lt;br&gt;勉強した内容をすぐ残したいので、日付・科目・時間・内容の追加フォームが欲しい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="260" height="80" as="geometry"/></mxCell><mxCell id="8" value="✅ &lt;b&gt;B04&lt;/b&gt; (3pt)&lt;br&gt;過去の記録を見返したいので、記録を新しい順に一覧表示したい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="260" height="80" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;合計 13pt&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="260" height="40" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;#2 資料置き場 ✅実装済&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="315" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="11" value="ゴール:数学の資料URLがまとまり、勉強時間の合計が見える" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="315" y="130" width="260" height="70" as="geometry"/></mxCell><mxCell id="12" value="✅ &lt;b&gt;B05&lt;/b&gt; (3pt)&lt;br&gt;授業資料のURLを1か所にまとめたいので、数学のリンク一覧を見たい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="315" y="210" width="260" height="80" as="geometry"/></mxCell><mxCell id="13" value="✅ &lt;b&gt;B06&lt;/b&gt; (2pt)&lt;br&gt;後で意味が分かるよう、リンクにタイトル・種類・メモを付けたい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="315" y="300" width="260" height="80" as="geometry"/></mxCell><mxCell id="14" value="✅ &lt;b&gt;B07&lt;/b&gt; (3pt)&lt;br&gt;頑張りを実感したいので、週・月の合計勉強時間を見たい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="315" y="390" width="260" height="80" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;合計 8pt&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="315" y="480" width="260" height="40" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;#3 業務ツール ✅実装済&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="590" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="17" value="ゴール:業務で触ったツールのメモが残せる" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;verticalAlign=top;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="590" y="130" width="260" height="70" as="geometry"/></mxCell><mxCell id="18" value="✅ &lt;b&gt;B08&lt;/b&gt; (3pt)&lt;br&gt;触ったツールを把握したいので、ツール一覧を見たい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="590" y="210" width="260" height="80" as="geometry"/></mxCell><mxCell id="19" value="✅ &lt;b&gt;B09&lt;/b&gt; (5pt)&lt;br&gt;再利用できるよう、ツール別に使い方・ハマりどころをメモしたい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="590" y="300" width="260" height="80" as="geometry"/></mxCell><mxCell id="20" value="✅ &lt;b&gt;B10&lt;/b&gt; (1pt)&lt;br&gt;調べ直しを減らすため、公式ドキュメントURLを保管したい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="590" y="390" width="260" height="80" as="geometry"/></mxCell><mxCell id="21" value="&lt;b&gt;合計 9pt&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="590" y="480" width="260" height="40" as="geometry"/></mxCell><mxCell id="22" value="&lt;b&gt;#4 読書・資格 ✅実装済&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="865" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="23" value="ゴール:本と資格の一覧が使える" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;verticalAlign=top;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="865" y="130" width="260" height="70" as="geometry"/></mxCell><mxCell id="24" value="✅ &lt;b&gt;B11&lt;/b&gt; (5pt)&lt;br&gt;読んだ本を残したいので、書名・著者・読了日・評価の一覧が欲しい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="865" y="210" width="260" height="80" as="geometry"/></mxCell><mxCell id="25" value="✅ &lt;b&gt;B12&lt;/b&gt; (2pt)&lt;br&gt;積読を管理したいので、読みたい/読書中/読了で分けて見たい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="865" y="300" width="260" height="80" as="geometry"/></mxCell><mxCell id="26" value="✅ &lt;b&gt;B13&lt;/b&gt; (3pt)&lt;br&gt;受験予定を把握したいので、資格名・試験日・状態の一覧が欲しい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="865" y="390" width="260" height="80" as="geometry"/></mxCell><mxCell id="27" value="✅ &lt;b&gt;B14&lt;/b&gt; (2pt)&lt;br&gt;勉強の締切感が欲しいので、試験日までの日数を表示したい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="865" y="480" width="260" height="80" as="geometry"/></mxCell><mxCell id="28" value="&lt;b&gt;合計 12pt&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="865" y="570" width="260" height="40" as="geometry"/></mxCell><mxCell id="29" value="&lt;b&gt;#5 拡張 ✅実装済&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1140" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="30" value="ゴール:物理・化学・検索・本の紹介" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;verticalAlign=top;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1140" y="130" width="260" height="70" as="geometry"/></mxCell><mxCell id="31" value="✅ &lt;b&gt;B15&lt;/b&gt; (2pt)&lt;br&gt;物理・化学の資料も同じ形式で管理したい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1140" y="210" width="260" height="80" as="geometry"/></mxCell><mxCell id="32" value="✅ &lt;b&gt;B16&lt;/b&gt; (3pt)&lt;br&gt;目的のリンクにすぐ着きたいので、分野やキーワードで絞り込みたい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1140" y="300" width="260" height="80" as="geometry"/></mxCell><mxCell id="33" value="✅ &lt;b&gt;B17&lt;/b&gt; (5pt)&lt;br&gt;おすすめしたい本を整理したいので、本の紹介ページを書きたい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1140" y="390" width="260" height="80" as="geometry"/></mxCell><mxCell id="34" value="&lt;b&gt;合計 10pt&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1140" y="480" width="260" height="40" as="geometry"/></mxCell><mxCell id="35" value="&lt;b&gt;#6 品質チェック&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1415" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="36" value="ゴール:W3C検証でエラー0、実機でも動く" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;verticalAlign=top;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1415" y="130" width="260" height="70" as="geometry"/></mxCell><mxCell id="37" value="⬜ &lt;b&gt;B26&lt;/b&gt; (2pt)&lt;br&gt;品質を保ちたいので、全ページをW3C HTMLチェッカー/CSSバリデータで検証し、実機ブラウザでも動作確認したい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1415" y="210" width="260" height="80" as="geometry"/></mxCell><mxCell id="38" value="&lt;b&gt;合計 2pt&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1415" y="300" width="260" height="40" as="geometry"/></mxCell><mxCell id="39" value="&lt;b&gt;🔤 メモ&lt;/b&gt;&lt;br&gt;・&lt;b&gt;ベロシティ&lt;/b&gt;:1イテレーションで終わったポイント数。回すうちに自分のペースが見えてくるので、次の計画の目安にする&lt;br&gt;・1回に詰め込みすぎない(最初は5〜10pt程度が目安)。終わらなければ次に回すだけでOK&lt;br&gt;・&lt;b&gt;未定&lt;/b&gt;のものはIter #5までの結果を見てから決める&lt;br&gt;・使ってみて新しい欲求が出たら、バックログに追加して優先度を付け直す&lt;br&gt;・&lt;b&gt;完成の定義(全ストーリー共通)&lt;/b&gt;:ブラウザで動く / 実データを1件入れて使えた / スマホ幅で崩れすぎない / &lt;b&gt;W3C HTMLチェッカー・CSSバリデータでエラー0&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;verticalAlign=top;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1580" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3.カンバン"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="🗂 カンバン:現在の状況(付箋を動かして使う)  ※Iter #1〜#5 は実装済み。残りは品質チェックと公開" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;未着手(To Do)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="500" height="45" as="geometry"/></mxCell><mxCell id="4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="500" height="640" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;作業中(Doing) ※同時は1〜2個まで&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#999999;fontSize=14;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="500" height="45" as="geometry"/></mxCell><mxCell id="6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="560" y="125" width="500" height="640" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;完了(Done)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=14;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1080" y="80" width="500" height="45" as="geometry"/></mxCell><mxCell id="8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1080" y="125" width="500" height="640" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;B26&lt;/b&gt;　W3C HTMLチェッカーで全ページを検査(エラー0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9b1;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="60" y="145" width="460" height="65" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;B26&lt;/b&gt;　W3C CSSバリデータでstyle.cssを検査(エラー0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9b1;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="60" y="225" width="460" height="65" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;B26&lt;/b&gt;　実機ブラウザ+スマホ幅で全画面を操作して確認" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9b1;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="60" y="305" width="460" height="65" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;B18&lt;/b&gt;　バックアップの書き出し→読み込みを実機で確認" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9b1;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="60" y="385" width="460" height="65" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;B25&lt;/b&gt;　公開方法を決める(GitHub Pages 等/公開しない選択もあり)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9b1;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="460" height="65" as="geometry"/></mxCell><mxCell id="14" value="✅ &lt;b&gt;Iter #1&lt;/b&gt;　B01〜B04 トップ・共通メニュー・勉強記録の追加/一覧/編集/削除" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f4e0;strokeColor=#82b366;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1100" y="145" width="460" height="65" as="geometry"/></mxCell><mxCell id="15" value="✅ &lt;b&gt;Iter #2&lt;/b&gt;　B05〜B07 授業資料リンク集、週・月の合計" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f4e0;strokeColor=#82b366;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1100" y="225" width="460" height="65" as="geometry"/></mxCell><mxCell id="16" value="✅ &lt;b&gt;Iter #3&lt;/b&gt;　B08〜B10 業務ツールの一覧・詳細メモ・公式URL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f4e0;strokeColor=#82b366;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1100" y="305" width="460" height="65" as="geometry"/></mxCell><mxCell id="17" value="✅ &lt;b&gt;Iter #4&lt;/b&gt;　B11〜B14 読書の一覧/状態分け、資格の一覧/カウントダウン" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f4e0;strokeColor=#82b366;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1100" y="385" width="460" height="65" as="geometry"/></mxCell><mxCell id="18" value="✅ &lt;b&gt;Iter #5+&lt;/b&gt;　B15〜B24 物理・化学、検索、本の紹介、バックアップ、グラフ、お気に入り、ダークモード ほか" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f4e0;strokeColor=#82b366;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1100" y="465" width="460" height="65" as="geometry"/></mxCell><mxCell id="19" value="&lt;b&gt;🔤 メモ&lt;/b&gt;&lt;br&gt;・&lt;b&gt;カンバン&lt;/b&gt;:作業を「未着手/作業中/完了」に並べて進み具合を見る板。draw.ioなら付箋の図形をドラッグして移動するだけ&lt;br&gt;・&lt;b&gt;WIP制限&lt;/b&gt;:同時に進める数を絞る。ひとりなら作業中は1〜2個にして「あれもこれも途中」を防ぐ&lt;br&gt;・ストーリー(B03など)を&lt;b&gt;タスク&lt;/b&gt;(小さな作業単位)に分けると、進捗が見えやすい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;verticalAlign=top;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1560" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>