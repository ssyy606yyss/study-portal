<mxfile host="app.diagrams.net"><diagram id="p0" name="1.プロダクトバックログ"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="📋 プロダクトバックログ(上にあるほど優先度が高い)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;見方:&lt;/b&gt; ストーリー=「自分として〜したいので、〜が欲しい」の形。受入条件=これを満たせば完成の目安。&lt;b&gt;優先度&lt;/b&gt;=Must(必須)/Should(できれば)/Could(余裕があれば)。&lt;b&gt;見積&lt;/b&gt;=ストーリーポイント(相対的な大きさ。1=すぐ、5=ちょっと大きい)。&lt;b&gt;Iter&lt;/b&gt;=入れる予定のイテレーション。状態は着手したら更新。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1620" height="70" as="geometry"/></mxCell><mxCell id="4" value="ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#444444;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="60" height="36" as="geometry"/></mxCell><mxCell id="5" value="エピック" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#444444;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="120" height="36" as="geometry"/></mxCell><mxCell id="6" value="ユーザーストーリー" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#444444;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="150" width="470" height="36" as="geometry"/></mxCell><mxCell id="7" value="受入条件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#444444;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="150" width="420" height="36" as="geometry"/></mxCell><mxCell id="8" value="優先度" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#444444;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="150" width="70" height="36" as="geometry"/></mxCell><mxCell id="9" value="見積" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#444444;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="55" height="36" as="geometry"/></mxCell><mxCell id="10" value="Iter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#444444;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1235" y="150" width="60" height="36" as="geometry"/></mxCell><mxCell id="11" value="状態" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#444444;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1295" y="150" width="80" height="36" as="geometry"/></mxCell><mxCell id="12" value="B01" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="60" height="56" as="geometry"/></mxCell><mxCell id="13" value="E0 基盤" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="100" y="186" width="120" height="56" as="geometry"/></mxCell><mxCell id="14" value="自分として、どのページからも5つの入口へ移動したいので、共通メニュー付きのトップページが欲しい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="220" y="186" width="470" height="56" as="geometry"/></mxCell><mxCell id="15" value="全ページに同じメニューが出る / スマホ幅でも崩れない" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="690" y="186" width="420" height="56" as="geometry"/></mxCell><mxCell id="16" value="Must" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1110" y="186" width="70" height="56" as="geometry"/></mxCell><mxCell id="17" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1180" y="186" width="55" height="56" as="geometry"/></mxCell><mxCell id="18" value="#1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1235" y="186" width="60" height="56" as="geometry"/></mxCell><mxCell id="19" value="実装済" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1295" y="186" width="80" height="56" as="geometry"/></mxCell><mxCell id="20" value="B02" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="242" width="60" height="56" as="geometry"/></mxCell><mxCell id="21" value="E0 基盤" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="100" y="242" width="120" height="56" as="geometry"/></mxCell><mxCell id="22" value="自分として、ファイルを探しやすいよう、html/ のフォルダ構成とCSSを共通化したい" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="220" y="242" width="470" height="56" as="geometry"/></mxCell><mxCell id="23" value="css/ js/ data/ が揃っている / 全ページが共通CSSを読み込む" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="690" y="242" width="420" height="56" as="geometry"/></mxCell><mxCell id="24" value="Must" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1110" y="242" width="70" height="56" as="geometry"/></mxCell><mxCell id="25" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1180" y="242" width="55" height="56" as="geometry"/></mxCell><mxCell id="26" value="#1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1235" y="242" width="60" height="56" as="geometry"/></mxCell><mxCell id="27" value="実装済" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1295" y="242" width="80" height="56" as="geometry"/></mxCell><mxCell id="28" value="B03" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff