<mxfile host="app.diagrams.net"><diagram id="p0" name="1.全体像"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="html フォルダの全体像(学習ポータルサイトの部品一式)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="36" as="geometry"/></mxCell><mxCell id="c4" value="このフォルダは「学習ポータル」という自分専用のWebサイトを作るための部品がすべて入っているフォルダです。&lt;br&gt;サーバーもインターネットも要りません。&lt;b&gt;index.html をブラウザで開く&lt;/b&gt;だけで動きます。入力したデータは、使っているブラウザの中(localStorage)に保存されます。" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1420" height="50" as="geometry"/></mxCell><mxCell id="c5" value="▼ 登場する部品は4種類+設計メモです。まず「何をする部品か」を『家』にたとえて押さえましょう。" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;HTML(12ファイル)&lt;/b&gt;&lt;br&gt;画面の「骨組み」です。見出し・ボタン・入力欄など、『何を画面に置くか』を書いたファイルです。&lt;br&gt;例: index.html, study/add.html&lt;br&gt;&lt;br&gt;たとえると →「家の柱と壁」" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="340" height="210" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;CSS(1ファイル: css/style.css)&lt;/b&gt;&lt;br&gt;画面の「見た目」を決めます。色・文字の大きさ・余白・ダークモードの配色など。全ページが同じ1つを共有します。&lt;br&gt;&lt;br&gt;たとえると →「壁紙と内装」" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="340" height="170" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;JavaScript(15ファイル: js/ フォルダ)&lt;/b&gt;&lt;br&gt;画面に「動き」を与えます。&lt;br&gt;・データを保存・読み込みする&lt;br&gt;・一覧やグラフを組み立てて表示する&lt;br&gt;・入力内容をチェックする&lt;br&gt;・ダークモードを切り替える&lt;br&gt;&lt;br&gt;js/ の中は2種類に分かれます。&lt;br&gt;① &lt;b&gt;共通部品&lt;/b&gt;(defs / store / ui / form / theme)&lt;br&gt;    → 複数のページから使い回される道具箱&lt;br&gt;② &lt;b&gt;ページ専用&lt;/b&gt;(home / study / books …)&lt;br&gt;    → 1つのページだけを担当&lt;br&gt;&lt;br&gt;たとえると →「電気配線とスイッチ」" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="520" y="180" width="400" height="440" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;localStorage(ブラウザ内の保存場所)&lt;/b&gt;&lt;br&gt;ファイルではなく、ブラウザが持っている小さな保存棚です。勉強記録・本・資格などのデータがここに入ります。&lt;br&gt;※ 違うブラウザ/PCからは見えません。&lt;br&gt;&lt;br&gt;たとえると →「家の中の金庫」" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1060" y="180" width="380" height="210" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;drawio(2ファイル・設計メモ)&lt;/b&gt;&lt;br&gt;drawio/ フォルダ内の図&lt;br&gt;サイトを作る前の「設計図・やることリスト」です。サイトの動作には使われません。&lt;br&gt;&lt;br&gt;たとえると →「建築前の設計図」" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="450" width="380" height="170" as="geometry"/></mxCell><mxCell id="c11" value="① &amp;lt;link&amp;gt; で読み込む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="② &amp;lt;script&amp;gt; で読み込む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="③ 画面の部品を作って表示する" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="④ データを読み書きする" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;画面が表示されるまでの超ざっくりした流れ&lt;/b&gt;&lt;br&gt;(1) ブラウザが HTML を読む → (2) HTML の指示で CSS と JavaScript も読み込む → (3) JavaScript が localStorage からデータを取り出す → (4) JavaScript がデータを使って画面の部品(一覧・グラフなど)を作る → (5) CSS の見た目が適用されて、完成した画面が表示される&lt;br&gt;詳しくは「6.動作の流れ」のページで解説します。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1400" height="150" as="geometry"/></mxCell><mxCell id="c16" value="凡例(色の意味)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="300" height="24" as="geometry"/></mxCell><mxCell id="c17" value="HTML" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="895" width="150" height="36" as="geometry"/></mxCell><mxCell id="c18" value="CSS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="210" y="895" width="150" height="36" as="geometry"/></mxCell><mxCell id="c19" value="JavaScript" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="380" y="895" width="150" height="36" as="geometry"/></mxCell><mxCell id="c20" value="データ保存" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="550" y="895" width="150" height="36" as="geometry"/></mxCell><mxCell id="c21" value="フォルダ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="720" y="895" width="150" height="36" as="geometry"/></mxCell><mxCell id="c22" value="設計メモ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="890" y="895" width="150" height="36" as="geometry"/></mxCell><mxCell id="c23" value="【このファイルの見方】&lt;br&gt;・1.全体像 → 2.フォルダ構造 → 3.画面のつながり → 4.読み込み関係 → 5.データの保存先 → 6.動作の流れ → 7.共通部品 → 8.用語集 の順に見ると理解しやすいです。&lt;br&gt;・図の中の矢印は「Aが Bを使う(呼ぶ・読む)」という向きを表しています。" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1400" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2.フォルダ構造"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1836" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="フォルダとファイルの一覧と役割" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="36" as="geometry"/></mxCell><mxCell id="c4" value="左から「html フォルダ」→「中のフォルダ」→「中のファイル(役割つき)」の順に並べています。ファイル名の色は種類を表します(青=HTML、黄=JS、紫=CSS、灰=設計メモ)。" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1620" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;html/&lt;/b&gt;&lt;br&gt;(いちばん外側のフォルダ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="200" height="70" as="geometry"/></mxCell><mxCell id="c6" value="html 直下のファイル&lt;br&gt;(フォルダに入っていないもの)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="126" width="220" height="70" as="geometry"/></mxCell><mxCell id="c7" value="index.html" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="260" height="38" as="geometry"/></mxCell><mxCell id="c8" value="サイトの入口(トップページ)。5つの分野への入口と、最近の勉強状況を表示する。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="800" height="38" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=1;strokeColor=#aaaaaa;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="data.html" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="260" height="38" as="geometry"/></mxCell><mxCell id="c11" value="データ管理ページ。全データを1つのファイルに書き出し(バックアップ)/読み込み(復元)する。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="800" height="38" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=1;strokeColor=#aaaaaa;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=1;strokeColor=#aaaaaa;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="drawio/&lt;br&gt;設計メモ(図)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="252" width="220" height="70" as="geometry"/></mxCell><mxCell id="c15" value="サイト構想.drawio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="224" width="260" height="38" as="geometry"/></mxCell><mxCell id="c16" value="サイトを作る前の構想メモ(設計図)。サイトの動作には関係しない。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="850" y="224" width="800" height="38" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=1;strokeColor=#aaaaaa;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="プロダクトバックログ.drawio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="224" width="260" height="38" as="geometry"/></mxCell><mxCell id="c19" value="作る機能の一覧と優先順位(B01〜B24)。サイトの動作には関係しない。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="850" y="224" width="800" height="38" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=1;strokeColor=#aaaaaa;" edge="1" parent="1" source="c14" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="html構成解説.drawio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="224" width="260" height="38" as="geometry"/></mxCell><mxCell id="c22" value="このファイル。html 配下の構成を初学者向けに解説した図。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="850" y="224" width="800" height="38" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=1;strokeColor=#aaaaaa;" edge="1" parent="1" source="c14" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=1;strokeColor=#aaaaaa;" edge="1" parent="1" source="c5" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="css/&lt;br&gt;見た目の担当" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="372" width="220" height="38" as="geometry"/></mxCell><mxCell id="c26" value="style.css" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="372" width="260" height="38" as="geometry"/></mxCell><mxCell id="c27" value="全ページ共通の見た目(色・余白・ボタン・ダークモード)。全HTMLが読み込む。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="850" y="372" width="800" height="38" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=1;strokeColor=#aaaaaa;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=1;strokeColor=#aaaaaa;" edge="1" parent="1" source="c5" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="js/&lt;br&gt;動きの担当" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;