strokeColor=#2d6a2d;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;strokeWidth=1;" edge="1" parent="1" source="c8" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeWidth=1;" edge="1" parent="1" source="c17" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2d6a2d;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;strokeWidth=1;" edge="1" parent="1" source="c9" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeWidth=1;" edge="1" parent="1" source="c19" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2d6a2d;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;strokeWidth=1;" edge="1" parent="1" source="c11" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2d6a2d;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;strokeWidth=1;" edge="1" parent="1" source="c11" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeWidth=1;" edge="1" parent="1" source="c20" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2d6a2d;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;strokeWidth=1;" edge="1" parent="1" source="c12" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeWidth=1;" edge="1" parent="1" source="c22" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2d6a2d;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;strokeWidth=1;" edge="1" parent="1" source="c14" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2d6a2d;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;strokeWidth=1;" edge="1" parent="1" source="c15" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2d6a2d;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;strokeWidth=1;" edge="1" parent="1" source="c16" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="&lt;b&gt;読み方&lt;/b&gt;&lt;br&gt;・study.js は勉強記録だけを触ります。&lt;br&gt;・home.js は表示のためだけに5種類を「読む」だけ。&lt;br&gt;・study-add.js や materials.js が他の箱を読むのは、「科目の入力候補」を作るためです。&lt;br&gt;・certs.js が資格を削除するとき、その資格の得点記録(certScores)も一緒に消します。&lt;br&gt;・backup.js は6種類すべてを書き出し/復元します(図では線を1本に省略)。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="280" height="330" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;データ1件の形(例)&lt;/b&gt;&lt;br&gt;&lt;br&gt;どの箱も「同じ形の記録を並べた配列」です。&lt;br&gt;1件ごとに必ず &lt;b&gt;id(背番号)&lt;/b&gt; を持ちます。&lt;br&gt;&lt;br&gt;勉強記録の例:&lt;br&gt;{ id: &quot;1700-123&quot;,&lt;br&gt;  date: &quot;2026-11-15&quot;,&lt;br&gt;  course: &quot;数学&quot;,&lt;br&gt;  minutes: 60,&lt;br&gt;  … }&lt;br&gt;&lt;br&gt;idがあるから「この1件だけ編集/削除」できます。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1180" y="520" width="280" height="350" as="geometry"/></mxCell><mxCell id="c47" value="【注意】localStorage は「そのブラウザの中だけ」に残ります。ブラウザのデータを消す・別のPCで開くとデータは見えません。だから data.html のバックアップ機能(JSONファイルへの書き出し)があります。" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1300" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="6.動作の流れ"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="実際の動きを追ってみる(2つの具体例)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="36" as="geometry"/></mxCell><mxCell id="c4" value="ファイル同士の関係は、「ある操作をしたとき、どのファイルが順番に働くか」を追うと理解しやすくなります。" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1620" height="50" as="geometry"/></mxCell><mxCell id="c5" value="【例A】ページを開いたとき(例: study/index.html を開く)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=15;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1500" height="28" as="geometry"/></mxCell><mxCell id="c6" value="1. ブラウザが&lt;br&gt;study/index.html を読む" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="240" height="80" as="geometry"/></mxCell><mxCell id="c7" value="HTMLに書かれた内容(見出し・空の一覧の枠)を上から順に読む" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="228" width="240" height="70" as="geometry"/></mxCell><mxCell id="c8" value="2. &amp;lt;head&amp;gt; で&lt;br&gt;theme.js を実行" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="140" width="240" height="80" as="geometry"/></mxCell><mxCell id="c9" value="保存済みのダークモード設定を先に適用(ちらつき防止)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="310" y="228" width="240" height="70" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="3. style.css を読み込む" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="140" width="240" height="80" as="geometry"/></mxCell><mxCell id="c12" value="色・余白など見た目を用意する" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="580" y="228" width="240" height="70" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="4. &amp;lt;body&amp;gt;末尾の&lt;br&gt;defs→store→ui→study.js" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="140" width="240" height="80" as="geometry"/></mxCell><mxCell id="c15" value="共通部品を順に読み込み、最後に専用JSを実行" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="850" y="228" width="240" height="70" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="5. study.js が&lt;br&gt;Store.load で取得" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="140" width="240" height="80" as="geometry"/></mxCell><mxCell id="c18" value="localStorage の studyRecords をJSONから配列に戻す" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1120" y="228" width="240" height="70" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="6. ui.js の h() で&lt;br&gt;一覧・グラフを作る" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1390" y="140" width="240" height="80" as="geometry"/></mxCell><mxCell id="c21" value="データを使って画面の部品を作り、HTMLの枠に入れる" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1390" y="228" width="240" height="70" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="【例B】勉強記録を1件追加したとき(study/add.html でフォーム入力 → 保存)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=15;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1500" height="28" as="geometry"/></mxCell><mxCell id="c24" value="1. 利用者が&lt;br&gt;フォームに入力して&lt;br&gt;「保存」を押す" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="240" height="100" as="geometry"/></mxCell><mxCell id="c25" value="study/add.html の画面上での操作" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="488" width="240" height="90" as="geometry"/></mxCell><mxCell id="c26" value="2. form.js が&lt;br&gt;入力をチェック" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="380" width="240" height="100" as="geometry"/></mxCell><mxCell id="c27" value="必須項目が空/数値が範囲外などを検査。問題があれば画面にエラー表示して中断" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="310" y="488" width="240" height="90" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="3. study-add.js が&lt;br&gt;記録のかたちに整える" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="380" width="240" height="100" as="geometry"/></mxCell><mxCell id="c30" value="入力値に id(背番号)を付ける。編集なら元の id を引き継ぐ" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="580" y="488" width="240" height="90" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c26" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="4. store.js の&lt;br&gt;Store.upsert を呼ぶ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="380" width="240" height="100" as="geometry"/></mxCell><mxCell id="c33" value="同じ id があれば上書き、無ければ追加する" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="850" y="488" width="240" height="90" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c29" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="5. localStorage に保存" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="380" width="240" height="100" as="geometry"/></mxCell><mxCell id="c36" value="配列を JSON 文字列に変換して studyRecords に書き込む" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1120" y="488" width="240" height="90" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c32" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="6. study/index.html へ移動&lt;br&gt;→ 例Aと同じ流れで表示" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1390" y="380" width="240" height="100" as="geometry"/></mxCell><mxCell id="c39" value="新しい記録が入った状態で一覧が再表示される" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1390" y="488" width="240" height="90" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c35" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;ここから分かる「役割分担」&lt;/b&gt;&lt;br&gt;&lt;br&gt;・&lt;b&gt;HTML&lt;/b&gt;:画面の枠(どこに何を置くか)だけを持つ。中身のデータは持たない。&lt;br&gt;・&lt;b&gt;ページ専用JS&lt;/b&gt;:そのページの「司令塔」。何をいつ表示し、ボタンが押されたら何をするかを決める。&lt;br&gt;・&lt;b&gt;共通部品のJS&lt;/b&gt;:司令塔が使う「道具」。store.js=保存係、ui.js=画面の部品づくり係、form.js=入力フォーム係、defs.js=決まりごとの台帳。&lt;br&gt;・&lt;b&gt;localStorage&lt;/b&gt;:データの置き場。ページを閉じても残る。&lt;br&gt;・&lt;b&gt;CSS&lt;/b&gt;:見た目だけを担当。動きやデータには関与しない。&lt;br&gt;&lt;br&gt;このように「1つのファイルは1つの仕事だけ」に分けておくと、直したいときに『どのファイルを開けばよいか』がすぐ分かります(例:選択肢を増やしたい → defs.js だけ直せば全ページに反映される)。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1600" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="7.共通部品の中身"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="共通部品(js/ の5ファイル)の中身" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="36" as="geometry"/></mxCell><mxCell id="c4" value="複数のページから使い回される5つの道具箱です。中に入っている主な「関数(=名前の付いた処理のかたまり)」を紹介します。" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1620" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;defs.js&lt;/b&gt;&lt;br&gt;決まりごとの台帳&lt;br&gt;(値だけで、処理は無い)&lt;br&gt;&lt;br&gt;・KEYS&lt;br&gt;  localStorage の箱の名前6つ&lt;br&gt;・MATERIAL_FIELDS(数学/物理…)&lt;br&gt;・TOOL_CATEGORIES / TOOL_LEVELS&lt;br&gt;・BOOK_STATUSES(読みたい/読書中/読了)&lt;br&gt;・CERT_STATUSES / SCORE_KINDS&lt;br&gt;・DEFAULT_COURSES(科目の候補)&lt;br&gt;&lt;br&gt;→ 選択肢を変えたいときはここだけ直す" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="380" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;store.js&lt;/b&gt;&lt;br&gt;保存係(Store)&lt;br&gt;&lt;br&gt;・load(key)&lt;br&gt;  箱の中身を配列で取り出す&lt;br&gt;・save(key, 配列)&lt;br&gt;  配列を丸ごと保存する&lt;br&gt;・newId()&lt;br&gt;  新しい背番号を作る&lt;br&gt;・get(key, id)&lt;br&gt;  id で1件探す&lt;br&gt;・upsert(key, 1件)&lt;br&gt;  あれば更新、無ければ追加&lt;br&gt;・remove(key, id)&lt;br&gt;  1件削除&lt;br&gt;&lt;br&gt;→ localStorage に直接触るのはほぼここだけ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="300" height="380" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ui.js&lt;/b&gt;&lt;br&gt;画面づくりの小道具&lt;br&gt;&lt;br&gt;・h(タグ, 属性, 子…)&lt;br&gt;  HTML要素を作る(最重要)&lt;br&gt;・clear(要素)  中身を空にする&lt;br&gt;・getQuery(名前)&lt;br&gt;  URLの ?id=… を読む&lt;br&gt;・setMessage()  成功/失敗の表示&lt;br&gt;・fillSelect()  選択肢を作る&lt;br&gt;・todayString / parseDate / addDays&lt;br&gt;  日付の計算&lt;br&gt;・fmtMinutes / stars&lt;br&gt;  表示の整形&lt;br&gt;・externalLink / isSafeUrl&lt;br&gt;  安全な外部リンク" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="720" y="130" width="300" height="380" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;form.js&lt;/b&gt;&lt;br&gt;入力フォーム係&lt;br&gt;&lt;br&gt;・buildForm(入れ先, 設定)&lt;br&gt;  「項目の定義」の配列から&lt;br&gt;  入力欄・ラベル・エラー表示を&lt;br&gt;  まとめて作る&lt;br&gt;&lt;br&gt;設定できること:&lt;br&gt;  項目名・種類(text/number/date…)&lt;br&gt;  必須か・最大文字数・選択肢&lt;br&gt;  入力候補・独自チェック&lt;br&gt;&lt;br&gt;→ 6ページのフォームを同じ部品で作る&lt;br&gt;(ui.js が先に必要)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="300" height="380" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;theme.js&lt;/b&gt;&lt;br&gt;ダークモード係&lt;br&gt;&lt;br&gt;・保存済みの設定(light/dark)を&lt;br&gt;  ページ表示前に適用&lt;br&gt;・ヘッダーの切替ボタンを押すと&lt;br&gt;  切り替えて localStorage に記憶&lt;br&gt;&lt;br&gt;→ 他の部品とは独立。&lt;br&gt;  全ページの &amp;lt;head&amp;gt; で最初に読む" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1400" y="130" width="260" height="380" as="geometry"/></mxCell><mxCell id="c10" value="KEYS を使う" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="h() を使う" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;たとえ話:レストランの厨房&lt;/b&gt;&lt;br&gt;・ページ専用JS=&lt;b&gt;シェフ&lt;/b&gt;(今日のメニュー=そのページの画面を決める)&lt;br&gt;・store.js=&lt;b&gt;食材倉庫の係&lt;/b&gt;(取り出す・しまう専門)/ localStorage=倉庫そのもの&lt;br&gt;・ui.js=&lt;b&gt;包丁・鍋などの調理器具&lt;/b&gt;(h() で料理=画面の部品を作る)&lt;br&gt;・form.js=&lt;b&gt;注文票のひな型&lt;/b&gt;(どの店員が書いても同じ形式で、書き間違いもチェック)&lt;br&gt;・defs.js=&lt;b&gt;レシピの共通ルール表&lt;/b&gt;(食材名の表記・メニューの種類)&lt;br&gt;・theme.js=&lt;b&gt;店内の照明スイッチ&lt;/b&gt;(明るい/暗いを切り替えて覚えておく)&lt;br&gt;&lt;br&gt;シェフは、倉庫係・調理器具・注文票・ルール表を「呼び出すだけ」で料理ができます。自分で全部やらないので、ページ専用JSは短くて読みやすくなっています。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1620" height="290" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="8.用語集"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="初学者向け用語集" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="36" as="geometry"/></mxCell><mxCell id="c4" value="このフォルダの中で出てくる言葉を、やさしく説明します。" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1420" height="50" as="geometry"/></mxCell><mxCell id="c5" value="HTML" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="190" height="100" as="geometry"/></mxCell><mxCell id="c6" value="Webページの「骨組み」を書く言語。見出し・段落・ボタンなどを &amp;lt;h1&amp;gt; &amp;lt;p&amp;gt; &amp;lt;button&amp;gt; のような「タグ」で表す。拡張子は .html。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="240" y="130" width="510" height="100" as="geometry"/></mxCell><mxCell id="c7" value="CSS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="130" width="190" height="100" as="geometry"/></mxCell><mxCell id="c8" value="Webページの「見た目」を決める言語。色・大きさ・余白・配置などを指定する。拡張子は .css。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="970" y="130" width="510" height="100" as="geometry"/></mxCell><mxCell id="c9" value="JavaScript(JS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="190" height="100" as="geometry"/></mxCell><mxCell id="c10" value="Webページに「動き」を与えるプログラミング言語。ボタンを押したときの処理、データの保存、画面の書き換えなどを担当。拡張子は .js。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="240" y="250" width="510" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&amp;lt;link&amp;gt; / &amp;lt;script&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="250" width="190" height="100" as="geometry"/></mxCell><mxCell id="c12" value="HTMLの中で、CSS/JSファイルを「読み込む」ためのタグ。これが無いとCSS/JSは使われない。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="970" y="250" width="510" height="100" as="geometry"/></mxCell><mxCell id="c13" value="ブラウザ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="190" height="100" as="geometry"/></mxCell><mxCell id="c14" value="Chrome や Edge など、Webページを表示するソフト。HTML・CSS・JSをここで解釈して動かす。このサイトはサーバー無しでブラウザだけで動く。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="240" y="370" width="510" height="100" as="geometry"/></mxCell><mxCell id="c15" value="localStorage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="370" width="190" height="100" as="geometry"/></mxCell><mxCell id="c16" value="ブラウザが持つ小さな保存場所。「名前(キー)」と「文字列」の組で保存できる。ページを閉じても残るが、ブラウザごとに別。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="970" y="370" width="510" height="100" as="geometry"/></mxCell><mxCell id="c17" value="JSON" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="190" height="100" as="geometry"/></mxCell><mxCell id="c18" value="データを文字列で表す形式。{ &quot;name&quot;: &quot;数学&quot;, &quot;minutes&quot;: 60 } のような見た目。localStorage は文字列しか保存できないので、配列→JSON→保存、読み込み時は逆に戻す。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="240" y="490" width="510" height="100" as="geometry"/></mxCell><mxCell id="c19" value="キー(KEYS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="490" width="190" height="100" as="geometry"/></mxCell><mxCell id="c20" value="localStorage の「箱の名前」。このサイトでは勉強記録=studyRecords など6つ。js/defs.js にまとめてある。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="970" y="490" width="510" height="100" as="geometry"/></mxCell><mxCell id="c21" value="id(背番号)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="190" height="100" as="geometry"/></mxCell><mxCell id="c22" value="データ1件ごとに付く重複しない番号。「この1件だけ編集/削除」を実現するために使う。store.js の newId() が作る。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="240" y="610" width="510" height="100" as="geometry"/></mxCell><mxCell id="c23" value="クエリ文字列(?id=…)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="610" width="190" height="100" as="geometry"/></mxCell><mxCell id="c24" value="URLの末尾に付ける『受け渡しメモ』。ページ間で「どのデータを開くか」を伝える。ui.js の getQuery() で読む。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="970" y="610" width="510" height="100" as="geometry"/></mxCell><mxCell id="c25" value="関数" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="190" height="100" as="geometry"/></mxCell><mxCell id="c26" value="名前を付けた処理のかたまり。例: Store.load(...) は『保存棚から取り出す』という処理を呼び出している。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="240" y="730" width="510" height="100" as="geometry"/></mxCell><mxCell id="c27" value="(function () { … })();" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="730" width="190" height="100" as="geometry"/></mxCell><mxCell id="c28" value="各ページ専用JSの外側に付いている書き方(即時実行関数)。中で作った変数が他のファイルと名前がぶつからないよう、囲いを作る役目。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="970" y="730" width="510" height="100" as="geometry"/></mxCell><mxCell id="c29" value="DOM / h()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="190" height="100" as="geometry"/></mxCell><mxCell id="c30" value="DOM=ブラウザ内にあるページの部品の集まり。h() は ui.js の関数で、そのDOMの部品(要素)を作る。innerHTMLを使わないのは入力文字が悪用されるのを防ぐため。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="240" y="850" width="510" height="100" as="geometry"/></mxCell><mxCell id="c31" value="バックアップ / 復元" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="850" width="190" height="100" as="geometry"/></mxCell><mxCell id="c32" value="data.html で、全データを1つのJSONファイルに書き出す(バックアップ)/ 読み込んで戻す(復元)機能。localStorageは消えやすいので保険として用意している。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="970" y="850" width="510" height="100" as="geometry"/></mxCell><mxCell id="c33" value="drawio ファイル" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="190" height="100" as="geometry"/></mxCell><mxCell id="c34" value="図を描くツール diagrams.net(draw.io)のファイル。サイトの構想や、やることリスト(プロダクトバックログ)が描かれている。サイトの動作には使わない。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="240" y="970" width="510" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>