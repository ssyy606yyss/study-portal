600" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3.画面のつながり"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="画面(HTMLページ)同士のつながり" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1480" height="36" as="geometry"/></mxCell><mxCell id="c4" value="矢印は「ここをクリック/操作すると、そのページに移動する」を表します。点線は「戻る」系の移動です。&lt;br&gt;なお全ページの上部には共通のメニュー(授業資料・勉強記録・読書・資格・業務ツール)があり、どのページからでも5分野へ移動できます(線が多くなるので図では省略)。" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1480" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;index.html&lt;/b&gt;&lt;br&gt;トップページ&lt;br&gt;(サイトの入口)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="200" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;data.html&lt;/b&gt;&lt;br&gt;データ管理&lt;br&gt;(バックアップ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="940" y="140" width="200" height="70" as="geometry"/></mxCell><mxCell id="c7" value="フッターのリンク" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeomet