=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="220" height="40" as="geometry"/></mxCell><mxCell id="c102" value="●" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="260" y="620" width="120" height="40" as="geometry"/></mxCell><mxCell id="c103" value="●" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="380" y="620" width="120" height="40" as="geometry"/></mxCell><mxCell id="c104" value="●" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="500" y="620" width="120" height="40" as="geometry"/></mxCell><mxCell id="c105" value="●" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="620" y="620" width="120" height="40" as="geometry"/></mxCell><mxCell id="c106" value="●" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="740" y="620" width="120" height="40" as="geometry"/></mxCell><mxCell id="c107" value="●" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="860" y="620" width="120" height="40" as="geometry"/></mxCell><mxCell id="c108" value="tools-edit.js" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="980" y="620" width="120" height="40" as="geometry"/></mxCell><mxCell id="c109" value="&lt;b&gt;ここに注目&lt;/b&gt;&lt;br&gt;&lt;br&gt;① &lt;b&gt;ほぼ全ページ共通&lt;/b&gt;&lt;br&gt;  style.css / theme.js / defs.js / store.js / ui.js は全12ページが読み込みます。だから見た目と基本の動きが全ページで揃います。&lt;br&gt;&lt;br&gt;② &lt;b&gt;form.js は「入力フォームがあるページだけ&lt;/b&gt;」&lt;br&gt;  materials / study/add / books / certs / certs/log / tools/edit。フォームが無いページは読み込みません(無駄を減らすため)。&lt;br&gt;&lt;br&gt;③ &lt;b&gt;ページ専用JSは1ページに1つ&lt;/b&gt;&lt;br&gt;  そのページ専用の処理が書かれています。&lt;br&gt;&lt;br&gt;④ &lt;b&gt;theme.js だけ &amp;lt;head&amp;gt; で読み込み&lt;/b&gt;&lt;br&gt;  画面が表示される前にダークモードを適用して、ちらつきを防ぐためです。他のJSは &amp;lt;body&amp;gt; の末尾で読み込みます。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1140" y="140" width="480" height="420" as="geometry"/></mxCell><mxCell id="c110" value="▼ 読み込む「順番」が大事です(後ろのファイルは、前のファイルの機能を使うため)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c111" value="&lt;b&gt;1. defs.js&lt;/b&gt;&lt;br&gt;決まりごと&lt;br&gt;(KEYS 等)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="220" height="90" as="geometry"/></mxCell><mxCell id="c112" value="&lt;b&gt;2. store.js&lt;/b&gt;&lt;br&gt;保存・読み込み&lt;br&gt;(Store)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="300" y="770" width="220" height="90" as="geometry"/></mxCell><mxCell id="c113" value="使う" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c112" target="c111"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c114" value="&lt;b&gt;3. ui.js&lt;/b&gt;&lt;br&gt;画面の小道具&lt;br&gt;(h, getQuery …)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="560" y="770" width="220" height="90" as="geometry"/></mxCell><mxCell id="c115" value="使う" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c114" target="c112"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c116" value="&lt;b&gt;4. form.js&lt;br&gt;(あるページだけ)&lt;/b&gt;&lt;br&gt;フォーム部品&lt;br&gt;(buildForm)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="820" y="770" width="220" height="90" as="geometry"/></mxCell><mxCell id="c117" value="使う" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c116" target="c114"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c118" value="&lt;b&gt;5. ページ専用JS&lt;/b&gt;&lt;br&gt;1〜4 の道具を&lt;br&gt;使って画面を作る" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1080" y="770" width="220" height="90" as="geometry"/></mxCell><mxCell id="c119" value="使う" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c118" target="c116"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c120" value="矢印は「右側のファイルが、左側のファイルの機能を使う」向きです。もし順番を逆にすると、まだ読み込まれていない機能を呼ぼうとして、エラーで動かなくなります。" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="1300" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="5.データの保存先"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="データはどこに保存され、どのJSが触るか" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="36" as="geometry"/></mxCell><mxCell id="c4" value="このサイトにはデータベースがありません。データは localStorage に「種類ごとの箱(キー)」を作って入れます。箱の名前は js/defs.js の KEYS で決めています。&lt;br&gt;実線の両矢印=「読む+書く(追加・変更・削除)」、点線の矢印=「読むだけ」を表します。" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1420" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;home.js&lt;/b&gt;&lt;br&gt;index.html 用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="240" height="54" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;study.js&lt;/b&gt;&lt;br&gt;study/index.html 用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="240" height="54" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;study-add.js&lt;/b&gt;&lt;br&gt;study/add.html 用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="240" height="54" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;materials.js&lt;/b&gt;&lt;br&gt;materials/index.html 用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="240" height="54" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;books.js&lt;/b&gt;&lt;br&gt;books/index.html 用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="240" height="54" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;review.js&lt;/b&gt;&lt;br&gt;books/review.html 用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="240" height="54" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;certs.js&lt;/b&gt;&lt;br&gt;certs/index.html 用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="240" height="54" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;log.js&lt;/b&gt;&lt;br&gt;certs/log.html 用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="240" height="54" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;tools.js&lt;/b&gt;&lt;br&gt;tools/index.html 用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="240" height="54" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;tools-detail.js&lt;/b&gt;&lt;br&gt;tools/detail.html 用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="240" height="54" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;tools-edit.js&lt;/b&gt;&lt;br&gt;tools/edit.html 用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="240" height="54" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;backup.js&lt;/b&gt;&lt;br&gt;data.html 用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="240" height="54" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;studyRecords&lt;/b&gt;&lt;br&gt;勉強記録 の配列(JSON)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="820" y="170" width="240" height="80" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;materialLinks&lt;/b&gt;&lt;br&gt;授業資料リンク の配列(JSON)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="820" y="290" width="240" height="80" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;books&lt;/b&gt;&lt;br&gt;読書 の配列(JSON)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="820" y="410" width="240" height="80" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;certs&lt;/b&gt;&lt;br&gt;資格 の配列(JSON)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="820" y="530" width="240" he