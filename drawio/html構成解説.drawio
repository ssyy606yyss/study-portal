ry"></mxGeometry></mxCell><mxCell id="c20" value="← 戻る / 編集の保存後" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.25;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="c18" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;books/review.html&lt;/b&gt;&lt;br&gt;1冊の紹介ページ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="200" height="80" as="geometry"/></mxCell><mxCell id="c22" value="書名リンク&lt;br&gt;(?id=本の番号)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="c12" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="← 読書へ戻る" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.25;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="c21" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;certs/log.html&lt;/b&gt;&lt;br&gt;得点の記録・グラフ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="880" y="520" width="200" height="80" as="geometry"/></mxCell><mxCell id="c25" value="「得点の記録」ボタン&lt;br&gt;(?cert=資格の番号)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="c14" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="← 資格へ戻る" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.25;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="c24" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;tools/detail.html&lt;/b&gt;&lt;br&gt;ツール1件の詳細" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1160" y="520" width="200" height="80" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;tools/edit.html&lt;/b&gt;&lt;br&gt;ツールの追加・編集" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1160" y="720" width="200" height="80" as="geometry"/></mxCell><mxCell id="c29" value="ツール名リンク&lt;br&gt;(?id=ツールの番号)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="c16" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="削除後に戻る / ← 戻る" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.25;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="c27" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="「ツールを追加する」" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="335"/><mxPoint x="1120" y="760"/></Array></mxGeometry></mxCell><mxCell id="c32" value="「編集する」" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="保存後に詳細へ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.25;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="c28" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;読み方のヒント&lt;/b&gt;&lt;br&gt;・「?id=…」「?cert=…」はURLの末尾につく『受け渡しメモ』です(クエリ文字列と呼びます)。&lt;br&gt;  例: review.html?id=1700-123 → 「番号 1700-123 の本の紹介を表示して」という意味。&lt;br&gt;  移動先のページは、JavaScript の getQuery() でこのメモを読み取り、どのデータを表示するか決めます。&lt;br&gt;・materials(授業資料)には「追加・編集」専用ページがありません。一覧ページの中に折りたたみ式のフォームがあり、同じページ内で追加・編集します。&lt;br&gt;・books / certs も同様に、追加・編集は一覧ページ内のフォームで行います。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1000" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4.読み込み関係"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="どのHTMLが、どのCSS・JavaScriptを読み込むか" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="36" as="geometry"/></mxCell><mxCell id="c4" value="HTMLファイルは、自分では何も動かせません。&amp;lt;link&amp;gt; や &amp;lt;script&amp;gt; という書き方で CSS/JS を「読み込んで」はじめて見た目と動きが付きます。下の表の ● が「そのファイルを読み込む」の意味です。" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1720" height="50" as="geometry"/></mxCell><mxCell id="c5" value="HTMLファイル ↓ / 読み込む物 →" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="220" height="40" as="geometry"/></mxCell><mxCell id="c6" value="css/style.css" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="140" width="120" height="40" as="geometry"/></mxCell><mxCell id="c7" value="js/theme.js" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="120" height="40" as="geometry"/></mxCell><mxCell id="c8" value="js/defs.js" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="140"