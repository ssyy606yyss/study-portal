<mxfile host="app.diagrams.net"><diagram id="p0" name="1.全体像"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="📚 学習ポータルサイト(仮) 構想ひな型" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;これは何?&lt;/b&gt;&lt;br&gt;自分専用の勉強まわりのハブ(拠点)サイト。大学の授業資料URLの置き場+勉強・読書・資格の記録帳。&lt;br&gt;&lt;b&gt;目的:&lt;/b&gt; ①あちこちに散らばった資料URLを1か所に ②勉強の積み重ねを見える化 ③&lt;b&gt;Webサイト構築の練習&lt;/b&gt;(これが一番大事!)&lt;br&gt;&lt;b&gt;利用者:&lt;/b&gt; 自分だけ(公開しない前提 → 認証やセキュリティは最初は気にしなくてOK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="120" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;学習ポータルサイト&lt;/b&gt;&lt;br&gt;トップページ(ダッシュボード)&lt;br&gt;最近の記録・今日のひとこと" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;fontSize=15;spacingLeft=0" vertex="1" parent="1"><mxGeometry x="640" y="260" width="320" height="90" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;① 授業資料ライブラリ&lt;/b&gt;&lt;br&gt;数学 / 物理 / 化学(主)&lt;br&gt;+ その他分野を追加可&lt;br&gt;分野→科目→資料URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=14" vertex="1" parent="1"><mxGeometry x="40" y="470" width="280" height="150" as="geometry"/></mxCell><mxCell id="6" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;② 勉強記録&lt;/b&gt;&lt;br&gt;日付・科目・時間・内容&lt;br&gt;週/月の合計時間&lt;br&gt;ひとこと振り返り" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=14" vertex="1" parent="1"><mxGeometry x="340" y="470" width="280" height="150" as="geometry"/></mxCell><mxCell id="8" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;③ 読書・本の紹介&lt;/b&gt;&lt;br&gt;読書記録(読了/読書中)&lt;br&gt;おすすめ本の紹介ページ&lt;br&gt;感想・評価★" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=14" vertex="1" parent="1"><mxGeometry x="640" y="470" width="280" height="150" as="geometry"/></mxCell><mxCell id="10" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="4" target="9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;④ 資格の記録&lt;/b&gt;&lt;br&gt;目標資格・試験日&lt;br&gt;学習進捗・模試の点数&lt;br&gt;取得済みの一覧" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=14" vertex="1" parent="1"><mxGeometry x="940" y="470" width="280" height="150" as="geometry"/></mxCell><mxCell id="12" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="4" target="11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;⑤ 業務ツール記録&lt;/b&gt;&lt;br&gt;業務で使ったツール/ソフト&lt;br&gt;用途・使い方メモ・ハマりどころ&lt;br&gt;使用経験(いつ・どの程度)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=14" vertex="1" parent="1"><mxGeometry x="1240" y="470" width="280" height="150" as="geometry"/></mxCell><mxCell id="14" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="4" target="13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;🔤 用語メモ&lt;/b&gt;&lt;br&gt;・&lt;b&gt;ハブ(hub)&lt;/b&gt;:いろんなものへの入口を集めた中心地点&lt;br&gt;・&lt;b&gt;ダッシュボード&lt;/b&gt;:最近の状況を一目で見られるトップ画面&lt;br&gt;・&lt;b&gt;要件定義&lt;/b&gt;:「何を作るか」を先に決めること。今回はそのゆるい版&lt;br&gt;・&lt;b&gt;ひな型&lt;/b&gt;:たたき台。作りながら何度でも書き換える前提" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1500" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2.サイトマップ"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="🗺 サイトマップ(どんなページを作る?)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;index.html&lt;/b&gt; トップ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0" vertex="1" parent="1"><mxGeometry x="660" y="70" width="280" height="60" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;授業資料&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=15" vertex="1" parent="1"><mxGeometry x="40" y="220" width="280" height="50" as="geometry"/></mxCell><mxCell id="5" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6" value="materials/index.html 分野タブ(数学/物理/化学/その他)・検索・★・追加フォーム" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="240" height="50" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;勉強記録&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=15" vertex="1" parent="1"><mxGeometry x="340" y="220" width="280" height="50" as="geometry"/></mxCell><mxCell id="8" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="3" target="7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" value="study/index.html 一覧・週/月の集計・科目別グラフ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="360" y="300" width="240" height="50" as="geometry"/></mxCell><mxCell id="10" value="add.html 記録の追加・編集" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="360" y="370" width="240" height="50" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;読書&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=15" vertex="1" parent="1"><mxGeometry x="640" y="220" width="280" height="50" as="geometry"/></mxCell><mxCell id="12" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="3" target="11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="books/index.html 一覧・状態で絞り込み・追加" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="660" y="300" width="240" height="50" as="geometry"/></mxCell><mxCell id="14" value="review.html 本の紹介(1冊1ページ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="660" y="370" width="240" height="50" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;資格&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=15" vertex="1" parent="1"><mxGeometry x="940" y="220" width="280" height="50" as="geometry"/></mxCell><mxCell id="16" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="3" target="15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="17" value="certs/index.html 資格一覧・試験日カウントダウン" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="300" width="240" height="50" as="geometry"/></mxCell><mxCell id="18" value="log.html 模試・過去問の得点と推移グラフ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="370" width="240" height="50" as="geometry"/></mxCell><mxCell id="19" value="&lt;b&gt;業務ツール&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=15" vertex="1" parent="1"><mxGeometry x="1240" y="220" width="280" height="50" as="geometry"/></mxCell><mxCell id="20" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="3" target="19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="21" value="tools/index.html 一覧・分類/習熟度で絞り込み" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1260" y="300" width="240" height="50" as="geometry"/></mxCell><mxCell id="22" value="detail.html ツール別メモ(1つ1ページ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1260" y="370" width="240" height="50" as="geometry"/></mxCell><mxCell id="23" value="edit.html 追加・編集" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1260" y="440" width="240" height="50" as="geometry"/></mxCell><mxCell id="24" value="&lt;b&gt;メモ&lt;/b&gt;&lt;br&gt;・ナビゲーション(全ページ共通のメニュー)を上部に置いて、どのページからも5つの入口に行けるようにする&lt;br&gt;・&lt;b&gt;【実装後の実際の構成】&lt;/b&gt;上の図が現在のページ構成。このほかに &lt;b&gt;data.html&lt;/b&gt;(データ管理:バックアップの書き出し/読み込み)があり、各ページのフッターからリンクしている&lt;br&gt;・最初は&lt;b&gt;各セクションの index.html だけ&lt;/b&gt;作れば十分。細かいページは後から増やす&lt;br&gt;・&lt;b&gt;相対パス&lt;/b&gt;(例 ../style.css)でページ同士をつなぐ練習になる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1500" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3.やりたいこと"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="✅ やりたいこと一覧(優先度つき)  ◎=まず作る ○=できれば △=余裕があれば" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;授業資料&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=15" vertex="1" parent="1"><mxGeometry x="40" y="90" width="280" height="50" as="geometry"/></mxCell><mxCell id="4" value="• ◎ 分野→科目→資料の階層でリンクを一覧表示&lt;br&gt;&lt;br&gt;• ◎ リンクに「タイトル・URL・メモ・種類(講義資料/演習/動画)」を付ける&lt;br&gt;&lt;br&gt;• ○ 分野・キーワードで絞り込み/検索&lt;br&gt;&lt;br&gt;• ○ お気に入り★マーク&lt;br&gt;&lt;br&gt;• △ リンク切れチェック(手動でOK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="150" width="280" height="480" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;勉強記録&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=15" vertex="1" parent="1"><mxGeometry x="340" y="90" width="280" height="50" as="geometry"/></mxCell><mxCell id="6" value="• ◎ 日付・科目・時間・内容を記録&lt;br&gt;&lt;br&gt;• ◎ 記録の一覧表示(新しい順)&lt;br&gt;&lt;br&gt;• ○ 週/月の合計時間を表示&lt;br&gt;&lt;br&gt;• △ 簡単なグラフ(科目別の時間)&lt;br&gt;&lt;br&gt;• △ カレンダー表示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="340" y="150" width="280" height="480" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;読書&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=15" vertex="1" parent="1"><mxGeometry x="640" y="90" width="280" height="50" as="geometry"/></mxCell><mxCell id="8" value="• ◎ 読書記録(書名・著者・読了日・評価★・感想)&lt;br&gt;&lt;br&gt;• ◎ 状態(読みたい/読書中/読了)で分類&lt;br&gt;&lt;br&gt;• ○ 本の紹介ページ(あらすじ・おすすめポイント)&lt;br&gt;&lt;br&gt;• △ 表紙画像の表示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="640" y="150" width="280" height="480" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;資格&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=15" vertex="1" parent="1"><mxGeometry x="940" y="90" width="280" height="50" as="geometry"/></mxCell><mxCell id="10" value="• ◎ 資格名・試験日・状態(勉強中/合格…)の一覧&lt;br&gt;&lt;br&gt;• ○ 試験日までのカウントダウン&lt;br&gt;&lt;br&gt;• ○ 模試・過去問の得点記録&lt;br&gt;&lt;br&gt;• △ 得点推移グラフ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="940" y="150" width="280" height="480" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;業務ツール&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=15" vertex="1" parent="1"><mxGeometry x="1240" y="90" width="280" height="50" as="geometry"/></mxCell><mxCell id="12" value="• ◎ ツール名・用途・分類・使った期間を記録&lt;br&gt;&lt;br&gt;• ◎ 使い方メモ/ハマりどころ/コマンドのメモ&lt;br&gt;&lt;br&gt;• ○ 公式ドキュメントURLの保管&lt;br&gt;&lt;br&gt;• ○ 習熟度(触った程度/実務で使える/人に教えられる)&lt;br&gt;&lt;br&gt;• △ 分類やキーワードで検索&lt;br&gt;&lt;br&gt;• ※業務の機密情報(社名・顧客・社内URL)は書かない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="1240" y="150" width="280" height="480" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;全体の共通ルール(非機能っぽいもの)&lt;/b&gt;&lt;br&gt;・スマホでも見やすい(レスポンシブ。CSSの練習になる)&lt;br&gt;・見た目はシンプル。ダークモードは余裕があれば&lt;br&gt;・記録データは最初は&lt;b&gt;ブラウザ内保存(localStorage)&lt;/b&gt;かJSONファイル。サーバーなしで動かす&lt;br&gt;・&lt;b&gt;バックアップ&lt;/b&gt;:記録データをJSONで書き出せるようにしておくと安心&lt;br&gt;&lt;br&gt;&lt;b&gt;用語:&lt;/b&gt; レスポンシブ=画面幅に合わせてレイアウトが変わること / localStorage=ブラウザに小さなデータを保存する仕組み / JSON=データを書くためのテキスト形式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1500" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4.記録する項目"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="🗃 記録するデータの項目(のちにJSONや表にする)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;授業資料リンク&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=14" vertex="1" parent="1"><mxGeometry x="40" y="90" width="240" height="45" as="geometry"/></mxCell><mxCell id="4" value="id&lt;br&gt;field(数学/物理/化学/他)&lt;br&gt;course(科目名)&lt;br&gt;title&lt;br&gt;url&lt;br&gt;type(講義資料/演習/動画…)&lt;br&gt;memo&lt;br&gt;favorite(★)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=8" vertex="1" parent="1"><mxGeometry x="40" y="135" width="240" height="330" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;勉強記録&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=14" vertex="1" parent="1"><mxGeometry x="295" y="90" width="240" height="45" as="geometry"/></mxCell><mxCell id="6" value="id&lt;br&gt;date&lt;br&gt;course(科目)&lt;br&gt;minutes(勉強時間)&lt;br&gt;content(やったこと)&lt;br&gt;reflection(ひとこと)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=8" vertex="1" parent="1"><mxGeometry x="295" y="135" width="240" height="330" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;本&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=14" vertex="1" parent="1"><mxGeometry x="550" y="90" width="240" height="45" as="geometry"/></mxCell><mxCell id="8" value="id&lt;br&gt;title&lt;br&gt;author&lt;br&gt;status(読みたい/読書中/読了)&lt;br&gt;finishedDate&lt;br&gt;rating(★1-5)&lt;br&gt;review(感想・紹介文)&lt;br&gt;tags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=8" vertex="1" parent="1"><mxGeometry x="550" y="135" width="240" height="330" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;資格&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=14" vertex="1" parent="1"><mxGeometry x="805" y="90" width="240" height="45" as="geometry"/></mxCell><mxCell id="10" value="id&lt;br&gt;name(資格名)&lt;br&gt;examDate&lt;br&gt;status(勉強中/受験済/合格)&lt;br&gt;targetScore&lt;br&gt;memo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=8" vertex="1" parent="1"><mxGeometry x="805" y="135" width="240" height="330" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;模試・得点ログ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=14" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="240" height="45" as="geometry"/></mxCell><mxCell id="12" value="id&lt;br&gt;certId(どの資格か)&lt;br&gt;date&lt;br&gt;kind(模試/過去問)&lt;br&gt;score&lt;br&gt;comment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=8" vertex="1" parent="1"><mxGeometry x="1060" y="135" width="240" height="330" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;業務ツール&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=14" vertex="1" parent="1"><mxGeometry x="1315" y="90" width="240" height="45" as="geometry"/></mxCell><mxCell id="14" value="id&lt;br&gt;name(ツール名)&lt;br&gt;category(開発/設計/管理/インフラ…)&lt;br&gt;purpose(何に使ったか)&lt;br&gt;period(使った期間)&lt;br&gt;level(習熟度)&lt;br&gt;officialUrl(公式URL)&lt;br&gt;notes(使い方・ハマりどころ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=8" vertex="1" parent="1"><mxGeometry x="1315" y="135" width="240" height="330" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;ポイント&lt;/b&gt;&lt;br&gt;・&lt;b&gt;id&lt;/b&gt;:1件ごとの背番号(重複しない番号)。あとで「この記録を編集/削除」するときに必要&lt;br&gt;・&lt;b&gt;certId&lt;/b&gt;:「どの資格のログか」を示す印。資格の id と同じ値を入れてつなぐ(関連づけ)&lt;br&gt;・勉強記録の &lt;b&gt;course&lt;/b&gt; は授業資料の科目名と合わせておくと、科目ごとの集計や資料へのリンクがやりやすい&lt;br&gt;・最初から完璧にしなくてOK。項目は作りながら増減させる&lt;br&gt;&lt;br&gt;&lt;b&gt;用語:&lt;/b&gt; エンティティ=記録する対象の種類(本、資格など) / 関連づけ=別の表のidを持たせてつなぐこと" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1500" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="5.アジャイルの進め方"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="🔁 アジャイルで作る:小さく作る → 使ってみる → 直す、をぐるぐる回す" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;① 計画&lt;/b&gt;&lt;br&gt;次の1イテレーションでやることをバックログから3〜5個選ぶ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=8" vertex="1" parent="1"><mxGeometry x="40" y="90" width="330" height="110" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;② 作る&lt;/b&gt;&lt;br&gt;動く最小の形で作る(見た目は後回しでOK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=8" vertex="1" parent="1"><mxGeometry x="420" y="90" width="330" height="110" as="geometry"/></mxCell><mxCell id="5" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;③ 使ってみる&lt;/b&gt;&lt;br&gt;実際に自分で記録を入れて使う" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=8" vertex="1" parent="1"><mxGeometry x="800" y="90" width="330" height="110" as="geometry"/></mxCell><mxCell id="7" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="4" target="6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;④ ふりかえり&lt;/b&gt;&lt;br&gt;やりにくかった所をメモ → バックログに追加" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=8" vertex="1" parent="1"><mxGeometry x="1180" y="90" width="330" height="110" as="geometry"/></mxCell><mxCell id="9" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="6" target="8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="次のイテレーションへ" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="8" target="3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;📋 プロダクトバックログ(やりたいことリスト・優先順)&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. トップページ+共通メニュー(5つの入口)&lt;br&gt;2. 授業資料:数学のリンクを表示&lt;br&gt;3. 勉強記録:追加フォーム+一覧&lt;br&gt;4. 業務ツール:一覧+1件ずつのメモ&lt;br&gt;5. 読書記録:一覧+状態分け&lt;br&gt;6. 資格:一覧+試験日カウントダウン&lt;br&gt;7. 物理・化学の資料、検索・絞り込み&lt;br&gt;8. 集計・グラフ、JSON書き出し&lt;br&gt;9. スマホ対応、ダークモード…&lt;br&gt;&lt;br&gt;&lt;i&gt;※順番は固定じゃない。使ってみて「今これが欲しい!」で並べ替える&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="250" width="740" height="330" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;🏁 イテレーション案(1回=1〜2週間 or 週末ごと)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;#1 骨組み:&lt;/b&gt;トップ+メニュー+勉強記録(いちばん使う)&lt;br&gt;&lt;b&gt;#2 資料置き場:&lt;/b&gt;数学の資料リンク&lt;br&gt;&lt;b&gt;#3 業務ツール記録:&lt;/b&gt;一覧+メモ&lt;br&gt;&lt;b&gt;#4 読書・資格:&lt;/b&gt;一覧ページ&lt;br&gt;&lt;b&gt;#5 以降:&lt;/b&gt;バックログから都度選ぶ&lt;br&gt;&lt;br&gt;&lt;b&gt;✅ 「できた」の基準(完成の定義)&lt;/b&gt;&lt;br&gt;・ブラウザで開いて動く&lt;br&gt;・実際にデータを1件入れて使えた&lt;br&gt;・スマホ幅で崩れすぎない&lt;br&gt;・&lt;b&gt;W3C HTMLチェッカー/CSSバリデータでエラー0&lt;/b&gt;(8ページ参照)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="820" y="250" width="720" height="330" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;🔤 用語メモ&lt;/b&gt;&lt;br&gt;・&lt;b&gt;アジャイル&lt;/b&gt;:最初に全部決めず、短いサイクルで作って、使って、直しながら育てる進め方&lt;br&gt;・&lt;b&gt;イテレーション(スプリント)&lt;/b&gt;:1回のサイクル。今回は自分用なので「1〜2週間」や「週末ごと」で柔軟に&lt;br&gt;・&lt;b&gt;バックログ&lt;/b&gt;:やりたいことの優先順リスト。いつでも追加・並べ替えOK&lt;br&gt;・&lt;b&gt;MVP&lt;/b&gt;:最小限で動く最初の版。まず勉強記録だけでもMVP&lt;br&gt;・&lt;b&gt;ふりかえり&lt;/b&gt;:やってみて良かった/困った点を整理して次に活かすこと&lt;br&gt;・&lt;b&gt;完成の定義(DoD)&lt;/b&gt;:「これを満たしたら完成」と決めた基準&lt;br&gt;&lt;br&gt;&lt;b&gt;💡 ひとりアジャイルのコツ:&lt;/b&gt;タスクはカンバン(未着手/作業中/完了の3列)に付箋で並べるだけで十分。&lt;br&gt;だから要件(2〜4ページ)は&lt;b&gt;仮置き&lt;/b&gt;。作りながら書き換える前提!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1500" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="6.使う言語(HTML/CSS/JS)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="🧰 使う言語は HTML + CSS + JavaScript の3つだけ(静的サイト)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;結論:&lt;/b&gt; 今回のサイトは&lt;b&gt;静的サイト&lt;/b&gt;(用意したファイルをそのままブラウザに表示するサイト)なので、&lt;b&gt;この3つで足りる&lt;/b&gt;。サーバー側の言語(PHP/Python等)やデータベースは今は不要。&lt;br&gt;3つは役割分担:&lt;b&gt;HTML=骨組み / CSS=見た目 / JavaScript=動き&lt;/b&gt;(家にたとえると 骨組み・内装・電気設備)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="70" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;HTML(骨組み・中身)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=15" vertex="1" parent="1"><mxGeometry x="40" y="170" width="480" height="50" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;役割:&lt;/b&gt;見出し・文章・リンク・表・フォームなど、ページの&lt;b&gt;中身と構造&lt;/b&gt;を書く&lt;br&gt;&lt;b&gt;拡張子:&lt;/b&gt; .html&lt;br&gt;&lt;br&gt;&lt;b&gt;このサイトで:&lt;/b&gt;&lt;br&gt;・各ページ(index.html など)&lt;br&gt;・共通メニュー(5つの入口へのリンク)&lt;br&gt;・授業資料のリンク一覧&lt;br&gt;・記録の入力フォーム&lt;br&gt;&lt;br&gt;&lt;b&gt;例:&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;&amp;lt;a href=&quot;math.html&quot;&amp;gt;数学&amp;lt;/a&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;バックログ:&lt;/b&gt;B01, B05 など" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="220" width="480" height="430" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;CSS(見た目)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=15" vertex="1" parent="1"><mxGeometry x="550" y="170" width="480" height="50" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;役割:&lt;/b&gt;色・文字サイズ・余白・配置など、&lt;b&gt;見た目とレイアウト&lt;/b&gt;を決める&lt;br&gt;&lt;b&gt;拡張子:&lt;/b&gt; .css&lt;br&gt;&lt;br&gt;&lt;b&gt;このサイトで:&lt;/b&gt;&lt;br&gt;・全ページ共通のデザイン(css/style.css)&lt;br&gt;・スマホでも崩れない配置(レスポンシブ)&lt;br&gt;・ダークモード(あとで)&lt;br&gt;&lt;br&gt;&lt;b&gt;例:&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;nav a { color: #333; }&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;バックログ:&lt;/b&gt;B01, B02, B24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="550" y="220" width="480" height="430" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;JavaScript(動き)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=15" vertex="1" parent="1"><mxGeometry x="1060" y="170" width="480" height="50" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;役割:&lt;/b&gt;ボタンを押したときの処理など、&lt;b&gt;ページを動かす&lt;/b&gt;。データの保存や表示の書き換えもここ&lt;br&gt;&lt;b&gt;拡張子:&lt;/b&gt; .js&lt;br&gt;&lt;br&gt;&lt;b&gt;このサイトで:&lt;/b&gt;&lt;br&gt;・記録の追加・保存(localStorage)&lt;br&gt;・一覧の絞り込み・検索&lt;br&gt;・週/月の集計、グラフ&lt;br&gt;・JSONの書き出し/読み込み&lt;br&gt;&lt;br&gt;&lt;b&gt;例:&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;localStorage.setItem('k', v);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;バックログ:&lt;/b&gt;B03, B04, B07, B16, B18" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="1060" y="220" width="480" height="430" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;📝 学ぶ順番(おすすめ)&lt;/b&gt;&lt;br&gt;① HTML → ② CSS → ③ JavaScript の順。&lt;br&gt;・HTMLだけでも「見える・リンクで移動できる」ページになる&lt;br&gt;・CSSで見た目を整える&lt;br&gt;・JSで「記録を残す」動きを足す&lt;br&gt;→ アジャイルのイテレーション#1〜#2はほぼHTML/CSS、勉強記録(B03)からJSが本格的に登場" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="680" width="740" height="230" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;🚫 今は使わないもの&lt;/b&gt;&lt;br&gt;・サーバー側の言語(PHP / Python / Node.js など)&lt;br&gt;・データベース(MySQL など)&lt;br&gt;・フレームワーク(React / Vue など):素のHTML/CSS/JSに慣れてから検討&lt;br&gt;&lt;br&gt;&lt;b&gt;🔤 用語:&lt;/b&gt; 静的サイト=サーバーが処理せずファイルをそのまま返すサイト / マークアップ言語=文書の構造を示す言語(HTMLなど。プログラミング言語ではない) / フレームワーク=開発を楽にする部品・型のセット" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="820" y="680" width="720" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="7.技術とフォルダ"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="🛠 使う技術(イテレーションごとに少しずつ導入)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;最初に学ぶ&lt;br&gt;HTML / CSS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=14" vertex="1" parent="1"><mxGeometry x="40" y="90" width="340" height="60" as="geometry"/></mxCell><mxCell id="4" value="・ページ構造、共通メニュー&lt;br&gt;・レイアウト、スマホ対応(レスポンシブ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="170" width="340" height="230" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;次に学ぶ&lt;br&gt;JavaScript&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=14" vertex="1" parent="1"><mxGeometry x="430" y="90" width="340" height="60" as="geometry"/></mxCell><mxCell id="6" value="・JSONの読み込み(fetch)&lt;br&gt;・フォーム、DOM操作、絞り込み&lt;br&gt;・localStorageに保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="430" y="170" width="340" height="230" as="geometry"/></mxCell><mxCell id="7" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="3" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;記録が増えたら&lt;br&gt;データ・グラフ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=14" vertex="1" parent="1"><mxGeometry x="820" y="90" width="340" height="60" as="geometry"/></mxCell><mxCell id="9" value="・集計、グラフ描画ライブラリ&lt;br&gt;・JSON書き出し/読み込み(バックアップ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="820" y="170" width="340" height="230" as="geometry"/></mxCell><mxCell id="10" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="5" target="8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;余裕が出たら&lt;br&gt;公開・サーバー化&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=14" vertex="1" parent="1"><mxGeometry x="1210" y="90" width="340" height="60" as="geometry"/></mxCell><mxCell id="12" value="・GitHub Pagesなどで公開(非公開運用でもOK)&lt;br&gt;・サーバー/DB化に挑戦" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="1210" y="170" width="340" height="230" as="geometry"/></mxCell><mxCell id="13" value="" style="endArrow=classic;html=1;strokeColor=#888888;" edge="1" parent="1" source="8" target="11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="&lt;b&gt;📁 フォルダ構成(案)  html/ 配下&lt;/b&gt;&lt;br&gt;&lt;br&gt;html/&lt;br&gt;├ index.html&lt;br&gt;├ css/style.css&lt;br&gt;├ js/(app.js など)&lt;br&gt;├ data/(links.json, books.json, tools.json …)&lt;br&gt;├ materials/(math, physics, chemistry)&lt;br&gt;├ study/&lt;br&gt;├ books/&lt;br&gt;├ certs/&lt;br&gt;└ tools/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="450" width="740" height="380" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;🔤 用語メモ&lt;/b&gt;&lt;br&gt;・&lt;b&gt;静的サイト&lt;/b&gt;:サーバー側の処理なしで、HTMLファイルをそのまま見せるサイト&lt;br&gt;・&lt;b&gt;DOM操作&lt;/b&gt;:JavaScriptでページの中身を書き換えること&lt;br&gt;・&lt;b&gt;fetch&lt;/b&gt;:JSONなどのデータをJSから読み込む命令&lt;br&gt;・&lt;b&gt;GitHub Pages&lt;/b&gt;:GitHubで無料で静的サイトを公開できる仕組み&lt;br&gt;・&lt;b&gt;デプロイ&lt;/b&gt;:作ったものを動く場所に置くこと&lt;br&gt;&lt;br&gt;&lt;b&gt;📝 あとで決めること&lt;/b&gt;&lt;br&gt;・授業資料は誰かの著作物なので、&lt;b&gt;URLだけ保管&lt;/b&gt;(ファイル自体は置かない)方針でOK?&lt;br&gt;・サイト名、デザインの雰囲気&lt;br&gt;・フレームワーク(React等)を使うかは、素のHTML/JSに慣れてから&lt;br&gt;・業務ツール記録に「業務の機密」をどこまで書くか(基本は書かない方針)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="820" y="450" width="720" height="380" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="8.品質チェック(Validation)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="✅ Validationチェッカーが通るように作る(最初からこの前提で書く)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;方針:&lt;/b&gt; HTMLは W3C の&lt;b&gt;HTMLチェッカー&lt;/b&gt;、CSSは W3C の&lt;b&gt;CSSバリデータ&lt;/b&gt;で「&lt;b&gt;エラー0&lt;/b&gt;」になる状態を保つ。&lt;br&gt;あとから直すより、&lt;b&gt;書くときに守る&lt;/b&gt;方が楽。各イテレーションの「完成の定義」にも入れる。&lt;br&gt;※チェッカーは「仕様に合っているかの確認ツール」で、合格証ではない(公式の注意書きどおり)。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="80" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;🔧 使うチェッカー(無料・公式)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;HTML:&lt;/b&gt; W3C Markup Validation Service / Nu Html Checker&lt;br&gt;https://validator.w3.org/nu/&lt;br&gt;→ 「ファイルをアップロード」か「直接入力」で、index.html などを検査&lt;br&gt;&lt;br&gt;&lt;b&gt;CSS:&lt;/b&gt; W3C CSS Validation Service&lt;br&gt;https://jigsaw.w3.org/css-validator/&lt;br&gt;→ style.css を「ファイルアップロード」か「直接入力」で検査&lt;br&gt;&lt;br&gt;&lt;i&gt;※ローカルのファイルはURLで検査できないため、アップロード/直接入力を使う&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="180" width="740" height="230" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;🔁 チェックの手順(ページを作るたびに)&lt;/b&gt;&lt;br&gt;&lt;br&gt;① HTML/CSSを書く、または変更する&lt;br&gt;② ブラウザで見た目と動きを確認&lt;br&gt;③ HTMLチェッカーにかける → &lt;b&gt;Error を0に&lt;/b&gt;&lt;br&gt;④ CSSバリデータにかける → &lt;b&gt;Error を0に&lt;/b&gt;&lt;br&gt;⑤ 警告(Warning)は内容を読んで、直すか判断(メモに残す)&lt;br&gt;⑥ OKなら「完了」にする(カンバンのDone)&lt;br&gt;&lt;br&gt;&lt;b&gt;Error&lt;/b&gt;=仕様違反(必ず直す) / &lt;b&gt;Warning&lt;/b&gt;=注意(直した方がよい場合あり)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="820" y="180" width="720" height="230" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;📝 HTMLを書くときのルール&lt;/b&gt;&lt;br&gt;&lt;br&gt;・1行目は &lt;font face='Courier New'&gt;&amp;lt;!DOCTYPE html&amp;gt;&lt;/font&gt;&lt;br&gt;・&lt;font face='Courier New'&gt;&amp;lt;html lang=&quot;ja&quot;&amp;gt;&lt;/font&gt; で言語を指定&lt;br&gt;・&lt;font face='Courier New'&gt;&amp;lt;head&amp;gt;&lt;/font&gt; に &lt;font face='Courier New'&gt;&amp;lt;meta charset=&quot;UTF-8&quot;&amp;gt;&lt;/font&gt; と &lt;font face='Courier New'&gt;&amp;lt;title&amp;gt;&lt;/font&gt;(必須)を入れる&lt;br&gt;・タグは正しく閉じる・入れ子の順番を守る(開いた順の逆に閉じる)&lt;br&gt;・&lt;b&gt;id は1ページ内で重複させない&lt;/b&gt;&lt;br&gt;・画像には &lt;font face='Courier New'&gt;alt&lt;/font&gt; 属性を付ける(&lt;font face='Courier New'&gt;&amp;lt;img src=&quot;..&quot; alt=&quot;説明&quot;&amp;gt;&lt;/font&gt;)&lt;br&gt;・見出しは h1 → h2 → h3 と順番に(h1はページに1つが基本)&lt;br&gt;・フォームの入力欄には &lt;font face='Courier New'&gt;&amp;lt;label&amp;gt;&lt;/font&gt; を付ける&lt;br&gt;・リストは &lt;font face='Courier New'&gt;&amp;lt;ul&amp;gt;&lt;/font&gt; の直下に &lt;font face='Courier New'&gt;&amp;lt;li&amp;gt;&lt;/font&gt; だけ置く&lt;br&gt;・古いタグ/属性(&lt;font face='Courier New'&gt;&amp;lt;font&amp;gt;&lt;/font&gt;、&lt;font face='Courier New'&gt;&amp;lt;center&amp;gt;&lt;/font&gt;、&lt;font face='Courier New'&gt;align=&lt;/font&gt; など)は使わない。見た目はCSSで&lt;br&gt;・ファイル名・パスは英数小文字(大文字小文字の違いで動かなくなる事故を防ぐ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="440" width="740" height="420" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;📝 CSSを書くときのルール&lt;/b&gt;&lt;br&gt;&lt;br&gt;・セミコロン &lt;font face='Courier New'&gt;;&lt;/font&gt; と波かっこ &lt;font face='Courier New'&gt;{ }&lt;/font&gt; を閉じ忘れない&lt;br&gt;・プロパティ名・値のスペルミスに注意(例: &lt;font face='Courier New'&gt;colour&lt;/font&gt; ではなく &lt;font face='Courier New'&gt;color&lt;/font&gt;)&lt;br&gt;・単位を付ける(&lt;font face='Courier New'&gt;10px&lt;/font&gt;。&lt;font face='Courier New'&gt;10&lt;/font&gt; だけはNG。0はOK)&lt;br&gt;・新しめのCSS(grid、変数など)は、バリデータの&lt;b&gt;プロファイル(CSS level 3 など)の設定&lt;/b&gt;を確認する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="820" y="440" width="720" height="200" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;⚠ よくあるエラー例&lt;/b&gt;&lt;br&gt;&lt;br&gt;・&lt;font face='Courier New'&gt;Element title must not be empty / Missing title&lt;/font&gt; → titleが無い/空&lt;br&gt;・&lt;font face='Courier New'&gt;An img element must have an alt attribute&lt;/font&gt; → altが無い&lt;br&gt;・&lt;font face='Courier New'&gt;Duplicate ID&lt;/font&gt; → idが重複している&lt;br&gt;・&lt;font face='Courier New'&gt;Stray end tag&lt;/font&gt; → 閉じタグだけ余っている&lt;br&gt;・&lt;font face='Courier New'&gt;Unclosed element&lt;/font&gt; → 閉じ忘れ&lt;br&gt;&lt;i&gt;(英語のメッセージ。意味が分からなければ検索や質問でOK)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="820" y="660" width="720" height="200" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;🔤 用語メモ&lt;/b&gt;&lt;br&gt;・&lt;b&gt;バリデーション(検証)&lt;/b&gt;:書いたHTML/CSSが仕様どおりの書き方かを機械でチェックすること&lt;br&gt;・&lt;b&gt;Nu Html Checker&lt;/b&gt;:W3Cが提供する現行のHTMLチェッカー(validator.w3.org/nu/)&lt;br&gt;・&lt;b&gt;W3C&lt;/b&gt;:HTMLやCSSの仕様を決めている国際的な団体&lt;br&gt;・&lt;b&gt;仕様に合っている ≠ 見やすい/使いやすい&lt;/b&gt;:バリデーションは最低ラインの確認。見た目や使い勝手は別に確認する&lt;br&gt;&lt;br&gt;&lt;b&gt;📚 公式ドキュメント:&lt;/b&gt; https://validator.w3.org/nu/about.html / https://validator.w3.org/docs/users.html / https://jigsaw.w3.org/css-validator/manual.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1500" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="9.チェック用リンク集"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="🔗 チェック・整形に使うサイト(リンクと、何をするサイトか)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;使い分け:&lt;/b&gt; 「仕様に合っているか」を見るのが&lt;b&gt;バリデータ&lt;/b&gt;(①②)、「別の観点でチェック」するのが&lt;b&gt;Lint&lt;/b&gt;(③)、「見やすく整える」のが&lt;b&gt;整形ツール&lt;/b&gt;(④)。&lt;br&gt;⚠ どれも入力したコードは外部サイトに送られる。&lt;b&gt;業務の機密情報を含むコードは貼らない&lt;/b&gt;(このサイトでは業務情報は書かない方針)。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="70" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;① W3C Markup Validation Service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="40" y="170" width="360" height="50" as="geometry"/></mxCell><mxCell id="5" value="https://validator.w3.org/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#1a5fb4;spacingTop=6;link=https://validator.w3.org/" vertex="1" parent="1"><mxGeometry x="40" y="220" width="360" height="60" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;運営:&lt;/b&gt;W3C(HTMLなどの仕様を決めている団体)&lt;br&gt;&lt;b&gt;種類:&lt;/b&gt;バリデータ(仕様に合っているかの検証)&lt;br&gt;&lt;br&gt;&lt;b&gt;できること:&lt;/b&gt;HTML・XHTML・SMIL・MathMLなどのマークアップが正しいかを検査&lt;br&gt;&lt;b&gt;入力方法:&lt;/b&gt;URL / ファイルアップロード / 直接入力(貼り付け)&lt;br&gt;&lt;b&gt;オプション:&lt;/b&gt;文字コード、文書タイプの指定、結果の表示形式(ソース表示、アウトライン表示など)&lt;br&gt;&lt;br&gt;&lt;b&gt;注意:&lt;/b&gt;・HTML5は「experimental(実験的)」扱いと表示されている&lt;br&gt;・CSSは検査対象外 → CSS用の別サービスを案内している&lt;br&gt;・現行HTMLは②の方を使うとよい" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="280" width="360" height="520" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;② Nu Html Checker&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="420" y="170" width="360" height="50" as="geometry"/></mxCell><mxCell id="8" value="https://validator.w3.org/nu/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#1a5fb4;spacingTop=6;link=https://validator.w3.org/nu/" vertex="1" parent="1"><mxGeometry x="420" y="220" width="360" height="60" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;運営:&lt;/b&gt;W3C(①と同じサイト内)&lt;br&gt;&lt;b&gt;種類:&lt;/b&gt;バリデータ(DTDに頼らない新しい方式。①の説明では「non-DTD-based validator」)&lt;br&gt;&lt;br&gt;&lt;b&gt;できること:&lt;/b&gt;HTMLの検査(&lt;b&gt;今回のメインのチェッカー&lt;/b&gt;)&lt;br&gt;&lt;b&gt;入力方法:&lt;/b&gt;URL入力欄が表示される。ファイル/貼り付けは別の入力タブ・画面で行う(確認できた範囲では、このページ上には見当たらなかった)&lt;br&gt;&lt;b&gt;オプション:&lt;/b&gt;ソース表示、アウトライン表示、画像レポート、「エラーと警告のみ」表示 など&lt;br&gt;&lt;br&gt;&lt;b&gt;注意:&lt;/b&gt;ページに「実験中のツールで、挙動は変わることがある」と明記されている" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;spacingTop=10" vertex="1" parent="1"><mxGeometry x="420" y="280" width="360" height="520" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;③ Another HTML-lint(htmllint.net)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="800" y="170" width="360" height="50" as="geometry"/></mxCell><mxCell id="11" value="https://www.htmllint.net/html-lint/htmllint.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#1a5fb4;spacingTop=6;link=https://www.htmllint.net/html-lint/htmllint.html" vertex="1" parent="1"><mxGeometry x="800" y="220" width="360" height="60" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;運営:&lt;/b&gt;Xyxon,inc.(ページ表記は2009-2010年。日本語サイト)&lt;br&gt;&lt;b&gt;種類:&lt;/b&gt;HTML Lint(多数の観点でチェックするツール)&lt;br&gt;&lt;br&gt;&lt;b&gt;できること:&lt;/b&gt;HTMLの文法チェック。約300項目のチェックから選べ、各項目に重大度(0〜9)がある。HTML5用のチェック群、古いタグ/属性のチェック、WAI(アクセシビリティ)関連のチェックも含まれる&lt;br&gt;&lt;b&gt;入力方法:&lt;/b&gt;URL / ファイル / データ貼り付け&lt;br&gt;&lt;b&gt;オプション:&lt;/b&gt;HTMLバージョンの指定、出力文字コード、リンク切れチェックなど&lt;br&gt;&lt;br&gt;&lt;b&gt;注意:&lt;/b&gt;・大きなファイルや日本語ファイル名はうまく動かないことがある&lt;br&gt;・貼り付け入力では一部のチェックが省略される" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;spacingTop=10" vertex="1" parent="1"><mxGeometry x="800" y="280" width="360" height="520" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;④ DirtyMarkup(HTML整形)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;align=center;spacingLeft=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="1180" y="170" width="360" height="50" as="geometry"/></mxCell><mxCell id="14" value="https://www.10bestdesign.com/dirtymarkup/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#1a5fb4;spacingTop=6;link=https://www.10bestdesign.com/dirtymarkup/" vertex="1" parent="1"><mxGeometry x="1180" y="220" width="360" height="60" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;運営:&lt;/b&gt;10 Best Design&lt;br&gt;&lt;b&gt;種類:&lt;/b&gt;整形ツール(フォーマッタ)。&lt;b&gt;検証はしない&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;できること:&lt;/b&gt;HTML・CSS・JavaScriptのコードを読みやすく整える(インデントや改行の統一)。HTML/CSS/JS別のページとAPIもある&lt;br&gt;&lt;b&gt;オプション:&lt;/b&gt;インデント(タブ/スペース数)、1行の長さ、全体/断片の出力、空行の扱いなど&lt;br&gt;&lt;br&gt;&lt;b&gt;注意:&lt;/b&gt;・エラーの有無は教えてくれない(→ ①②で検査する)&lt;br&gt;・使い方:整形 → ①②で検査、の順がおすすめ&lt;br&gt;・入力欄の使い方は、このリンク集の作成時には未確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;spacingTop=10" vertex="1" parent="1"><mxGeometry x="1180" y="280" width="360" height="520" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;おすすめの流れ&lt;/b&gt;&lt;br&gt;書く → (④で整形して読みやすくする) → &lt;b&gt;②でHTMLを検査&lt;/b&gt; → CSSは&lt;b&gt;W3C CSS Validation Service&lt;/b&gt;(https://jigsaw.w3.org/css-validator/)で検査 → 気になる点があれば③で別観点のチェック&lt;br&gt;&lt;br&gt;&lt;b&gt;🔤 用語:&lt;/b&gt; &lt;b&gt;バリデータ&lt;/b&gt;=仕様どおりかを検証するツール / &lt;b&gt;Lint(リント)&lt;/b&gt;=仕様違反だけでなく、怪しい書き方や推奨されない書き方も指摘するツール / &lt;b&gt;フォーマッタ&lt;/b&gt;=コードの見た目(インデント等)を整えるツール&lt;br&gt;※内容は各サイトの記載をもとにまとめたもの。仕様や挙動は変わることがあるので、使う前に各サイトの説明も確認する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1500" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>